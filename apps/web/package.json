{
  "name": "mini-sportsbook-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "node --test tools/*.test.js"
  },
  "dependencies": {
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.15.3",
    "@vitejs/plugin-vue": "6.0.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.1.8"
  }
}
