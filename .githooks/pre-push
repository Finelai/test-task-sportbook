#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/master)
      printf '%s\n' 'Direct pushes to master are not allowed; use a pull request.' >&2
      exit 1
      ;;
    refs/heads/*)
      # Branch deletion has no source branch to validate.
      if [ "$local_ref" != '(delete)' ]; then
        sh "$repo_root/tools/git-hooks/check-branch-name.sh" "${remote_ref#refs/heads/}"
      fi
      ;;
  esac
done
