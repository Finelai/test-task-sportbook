#!/bin/sh
set -eu

subject=$(sed -n '1p' "$1")
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^()[:space:]]+\))?(!)?: [^[:space:]].*$'; then
  printf '%s\n' \
    'Invalid commit message. Use: type(scope)!: description' \
    'Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.' \
    'Example: feat(api): add bets endpoint' >&2
  exit 1
fi
